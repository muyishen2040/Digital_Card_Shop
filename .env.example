# Dedicated Digital Card Shop Supabase project (server-only).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Production-only Vercel Cron cleanup authorization, independent from other secrets.
CRON_SECRET=

# Existing preview-only creation pilot; never expose as NEXT_PUBLIC_.
CARD_CREATOR_ACCESS_CODE=

# Public creation is fail-closed until ALL safeguards and migration are ready.
# Both flags must be set to true for a public launch, then redeploy.
CARD_PUBLIC_CREATION_ENABLED=false
NEXT_PUBLIC_CARD_PUBLIC_CREATION_ENABLED=false
# Public widget site key, registered for the deployed domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only Cloudflare Turnstile secret; never commit or expose.
TURNSTILE_SECRET_KEY=
# Server-only 32+-character random key for IP HMAC; never reuse other credentials.
CARD_RATE_LIMIT_SECRET=
